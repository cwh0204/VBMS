<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Converters\**" />
    <Compile Remove="Data\**" />
    <Compile Remove="ViewModels\Base\**" />
    <Compile Remove="ViewModels\Dialogs\**" />
    <EmbeddedResource Remove="Converters\**" />
    <EmbeddedResource Remove="Data\**" />
    <EmbeddedResource Remove="ViewModels\Base\**" />
    <EmbeddedResource Remove="ViewModels\Dialogs\**" />
    <None Remove="Converters\**" />
    <None Remove="Data\**" />
    <None Remove="ViewModels\Base\**" />
    <None Remove="ViewModels\Dialogs\**" />
    <Page Remove="Converters\**" />
    <Page Remove="Data\**" />
    <Page Remove="ViewModels\Base\**" />
    <Page Remove="ViewModels\Dialogs\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.5" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Notification.Wpf" Version="11.0.0" />
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua" Version="1.5.378.156" />
    <PackageReference Include="System.Threading.Channels" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Tests\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Config\appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

 <PropertyGroup>
   <!-- 프로젝트 전체에서 패키지 타겟 프레임워크 불일치 경고 억제 -->
   <NoWarn>$(NoWarn);NU1701</NoWarn>
 </PropertyGroup>

</Project>
