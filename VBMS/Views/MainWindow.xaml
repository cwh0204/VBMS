<Window x:Class="VBMS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:VBMS.ViewModels"
        xmlns:components="clr-namespace:VBMS.Views.Components"
        xmlns:notifications="clr-namespace:Notification.Wpf.Controls;assembly=Notification.Wpf"
        mc:Ignorable="d"
        Title="VBMS - 배터리 랙 통합 관제 시스템" Height="950" Width="1440"
        WindowState="Maximized"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        Background="{DynamicResource MaterialDesignBackground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 이 ViewModel을 만나면 FireAlarmPopupView를 사용하라고 지정 -->
        <DataTemplate DataType="{x:Type vm:FireAlarmPopupViewModel}">
            <components:FireAlarmPopupView />
        </DataTemplate>
    </Window.Resources>

    <!-- 윈도우 데이터 컨텍스트에 뷰모델 할당 -->
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 상단 헤더 -->
            <RowDefinition Height="*"/>
            <!-- 메인 콘텐츠 영역 -->
        </Grid.RowDefinitions>

        <!-- 1. 상단 타이틀 헤더 영역 -->
        <materialDesign:Card Grid.Row="0" Padding="16,8" Margin="0,0,0,10" UniformCornerRadius="6" 
                             materialDesign:ElevationAssist.Elevation="Dp1">
            <DockPanel LastChildFill="False">
                <!-- 로고 및 시스템 타이틀 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Test" FontSize="18" FontWeight="Bold" Foreground="#FFC107" Margin="0,0,4,0" VerticalAlignment="Center"/>

                    <TextBlock Text="VBMS" FontSize="14" FontWeight="Bold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <TextBlock Text="|   배터리 랙 실시간 화재 및 안전 통합 관제 시스템" FontSize="13" VerticalAlignment="Center" 
                               Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>
                </StackPanel>

                <!-- 우측 시계 및 버튼 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Sample" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignBody}"/>

                    <TextBlock Text="2026-08-10 11:15:00" FontWeight="Medium" Margin="0,0,16,0" VerticalAlignment="Center" 
                               Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>

                    <!-- ☀️/🌙 라이트/다크 모드 전환 토글 버튼 -->
                    <ToggleButton Style="{StaticResource MaterialDesignIconButton}"
                                  IsChecked="{Binding IsDarkMode}"
                                  Command="{Binding ToggleThemeCommand}"
                                  ToolTip="테마 전환 (라이트 / 다크 모드)"
                                  Margin="0,0,8,0">
                        <materialDesign:PackIcon Width="20" Height="20">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <!-- 기본값: 라이트모드 (낮/해) -->
                                    <Setter Property="Kind" Value="WeatherSunny"/>
                                    <Setter Property="Foreground" Value="#FF9800"/>
                                    <Style.Triggers>
                                        <!-- 다크모드 활성화 시 (밤/달) -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=IsChecked}" Value="True">
                                            <Setter Property="Kind" Value="WeatherNight"/>
                                            <Setter Property="Foreground" Value="#FFD700"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                    </ToggleButton>

                    <Button Style="{StaticResource MaterialDesignIconButton}" 
                            ToolTip="이벤트 로그 팝업" 
                            Command="{Binding OpenDataInquiryCommand}"
                            Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="ViewList" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="설정">
                        <materialDesign:PackIcon Kind="Cog" Foreground="{DynamicResource MaterialDesignBody}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- 2. 메인 콘텐츠 영역 (좌우 분할 레이아웃) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <!-- 좌측: 랙 관제 매트릭스 -->
                <ColumnDefinition Width="1*"/>
                <!-- 우측: 드라이브 용량 및 데이터 로그 -->
            </Grid.ColumnDefinitions>

            <!-- [좌측] 랙 매트릭스 영역 (RackView 적용) -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,6,0">
                <ItemsControl ItemsSource="{Binding RackList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <!-- 분리된 RackView 연결 -->
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <components:RackView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- [우측] 드라이브 용량 및 실시간 데이터 로그 영역 -->
            <materialDesign:Card Grid.Column="1" Margin="6,0,0,0" Padding="12" UniformCornerRadius="8" 
                                 materialDesign:ElevationAssist.Elevation="Dp2" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 1. 드라이브 용량 모니터링 (가로 2열) -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- C 드라이브 -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="C 드라이브 사용량" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                            <ProgressBar Value="84" Height="6" Margin="0,4,0,0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="237GB 중 196GB 사용 가능" FontSize="10" Margin="0,2,0,0" 
                                       Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>
                        </StackPanel>

                        <!-- D 드라이브 -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="D 드라이브 사용량" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"/>
                            <ProgressBar Value="0" Height="6" Margin="0,4,0,0" Foreground="#4CAF50"/>
                            <TextBlock Text="1862GB 중 1862GB 사용 가능" FontSize="10" Margin="0,2,0,0" 
                                       Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>
                        </StackPanel>
                    </Grid>

                    <Separator Grid.Row="1" Margin="0,0,0,8"/>

                    <!-- 2. 실시간 이벤트 데이터 로그 그리드 -->
                    <DataGrid Grid.Row="2" 
                              Style="{StaticResource MaterialDesignDataGrid}"
                              ItemsSource="{Binding EventLogList}" 
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="Transparent"
                              BorderThickness="0"
                              FontSize="11"
                              RowHeight="30">

                        <!-- 헤더 정렬 및 여백 옵션 -->
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                <Setter Property="Padding" Value="2,4"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ROW" Width="60" Binding="{Binding Row}"/>
                            <DataGridTextColumn Header="BAY" Width="60" Binding="{Binding Bay}"/>
                            <DataGridTextColumn Header="LEVEL" Width="60" Binding="{Binding Level}"/>
                            <DataGridTextColumn Header="CONTENT" Width="*" Binding="{Binding Content}"/>
                            <DataGridTextColumn Header="DATETIME" Width="80" Binding="{Binding DateTime}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ⭐ 화재 알림 팝업 오버레이 레이어 -->
        <ItemsControl ItemsSource="{Binding ActiveAlarms}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,20,0,0"
                      Panel.ZIndex="999"
                      Grid.RowSpan="2">

            <!-- 세로로 쌓이도록 패널 설정 -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!-- 팝업 목록 항목 템플릿 (Window.Resources에 등록된 DataTemplate 자동 매핑) -->
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentPresenter Content="{Binding}" Margin="0,0,0,10"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>