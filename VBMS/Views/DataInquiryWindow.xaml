<Window x:Class="VBMS.Views.DataInquiryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="통계 및 이력 조회 (DATA INQUIRY)" 
        Height="850" Width="1400"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- DataGrid 헤더 스타일 -->
        <Style x:Key="ModernGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#475569"/>
        </Style>

        <!-- DataGrid 셀 스타일 -->
        <Style x:Key="ModernGridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid 행 스타일 -->
        <Style x:Key="ModernGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0284C7"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top Bar -->
            <RowDefinition Height="1.2*"/>
            <!-- Section 1: 차트 -->
            <RowDefinition Height="1*"/>
            <!-- Section 2 & 3: 로그 그리드 -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- Row 0: Top Bar -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ChartLine" Width="22" Height="22" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="데이터 조회 (DATA INQUIRY)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,30,0"/>

                    <TextBlock Text="날짜" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="13"/>
                    <DatePicker SelectedDate="{Binding ChartStartDate}" Width="120" Height="32" Background="White" VerticalContentAlignment="Center" Padding="6,0"/>
                    <TextBlock Text="~" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0" FontWeight="Bold"/>
                    <DatePicker SelectedDate="{Binding ChartEndDate}" Width="120" Height="32" Background="White" VerticalContentAlignment="Center" Padding="6,0"/>

                    <Button Command="{Binding SearchChartCommand}" Margin="12,0,0,0" Background="#0284C7" BorderBrush="#0284C7" Foreground="White" Height="32" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="검색" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding CurrentTimeString}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- Row 1: Section 1 - LiveCharts2 그래프 교체 완료 영역 -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="4" Height="16" Background="#0284C7" Margin="0,0,8,0" CornerRadius="2"/>
                    <TextBlock Text="1. 열별 평균온도" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                </StackPanel>

                <!-- 🌟 실제 LiveCharts2 그래프 바인딩 🌟 -->
                <lvc:CartesianChart Grid.Row="1" 
                                    Series="{Binding TemperatureSeries}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    LegendPosition="Right"/>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- Row 2: Section 2 & 3 - Event / 화재보고 2분할 -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 하단 좌측: Event 데이터 조회 -->
            <Border Grid.Column="0" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="4" Height="16" Background="#0284C7" Margin="0,0,8,0" CornerRadius="2"/>
                        <TextBlock Text="2. Event 데이터 조회" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Text="날짜" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="#475569" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding EventStartDate}" Width="110" Height="28" Background="White" FontSize="11" VerticalContentAlignment="Center"/>
                        <TextBlock Text="~" VerticalAlignment="Center" Margin="6,0" Foreground="#475569"/>
                        <DatePicker SelectedDate="{Binding EventEndDate}" Width="110" Height="28" Background="White" FontSize="11" VerticalContentAlignment="Center"/>

                        <Button Command="{Binding SearchEventsCommand}" Background="#0284C7" BorderBrush="#0284C7" Foreground="White" Height="28" Padding="10,0" Margin="8,0,0,0" FontSize="11">
                            <TextBlock Text="검색"/>
                        </Button>
                        <Button Command="{Binding ExportEventsExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="10,0" Margin="4,0,0,0" FontSize="11">
                            <TextBlock Text="엑셀 저장"/>
                        </Button>
                    </WrapPanel>

                    <DataGrid Grid.Row="2" 
                              ItemsSource="{Binding EventLogs}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#334155"
                              ColumnHeaderStyle="{StaticResource ModernGridHeader}"
                              RowStyle="{StaticResource ModernGridRow}"
                              CellStyle="{StaticResource ModernGridCell}"
                              Background="#1E293B"
                              BorderThickness="1"
                              BorderBrush="#334155">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시간" Binding="{Binding DateTime}" Width="140"/>
                            <DataGridTextColumn Header="열" Binding="{Binding Row, StringFormat='상온 {0}'}" Width="80"/>
                            <DataGridTextColumn Header="연" Binding="{Binding Bay}" Width="50"/>
                            <DataGridTextColumn Header="단" Binding="{Binding Level}" Width="50"/>
                            <DataGridTextColumn Header="내용" Binding="{Binding Content}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 하단 우측: 화재보고 데이터 조회 -->
            <Border Grid.Column="2" Background="White" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="4" Height="16" Background="#EF4444" Margin="0,0,8,0" CornerRadius="2"/>
                        <TextBlock Text="3. 화재보고 데이터 조회" FontWeight="Bold" FontSize="14" Foreground="#EF4444"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Text="날짜" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" Foreground="#475569" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding FireStartDate}" Width="110" Height="28" Background="White" FontSize="11" VerticalContentAlignment="Center"/>
                        <TextBlock Text="~" VerticalAlignment="Center" Margin="6,0" Foreground="#475569"/>
                        <DatePicker SelectedDate="{Binding FireEndDate}" Width="110" Height="28" Background="White" FontSize="11" VerticalContentAlignment="Center"/>

                        <Button Command="{Binding SearchFireReportsCommand}" Background="#EF4444" BorderBrush="#EF4444" Foreground="White" Height="28" Padding="10,0" Margin="8,0,0,0" FontSize="11">
                            <TextBlock Text="검색"/>
                        </Button>
                        <Button Command="{Binding ExportFireReportsExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="10,0" Margin="4,0,0,0" FontSize="11">
                            <TextBlock Text="엑셀 저장"/>
                        </Button>
                    </WrapPanel>

                    <DataGrid Grid.Row="2" 
                              ItemsSource="{Binding FireReports}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#334155"
                              ColumnHeaderStyle="{StaticResource ModernGridHeader}"
                              RowStyle="{StaticResource ModernGridRow}"
                              CellStyle="{StaticResource ModernGridCell}"
                              Background="#1E293B"
                              BorderThickness="1"
                              BorderBrush="#334155">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시간" Binding="{Binding DateTime}" Width="140"/>
                            <DataGridTextColumn Header="열" Binding="{Binding Row, StringFormat='상온 {0}'}" Width="80"/>
                            <DataGridTextColumn Header="연" Binding="{Binding Bay}" Width="50"/>
                            <DataGridTextColumn Header="단" Binding="{Binding Level}" Width="50"/>
                            <DataGridTextColumn Header="내용" Binding="{Binding Content}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>