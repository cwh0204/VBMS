<Window x:Class="VBMS.Views.DataInquiryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="{DynamicResource Str_DataInquiryTitle}" 
        Height="900" Width="1450"
        MinHeight="750" MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignBackground}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        FontFamily="{materialDesign:MaterialDesignFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 테마 적응형 DataGrid 헤더 스타일 -->
        <Style x:Key="ModernGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
        </Style>

        <!-- 테마 적응형 DataGrid 셀 스타일 -->
        <Style x:Key="ModernGridCell" TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 테마 적응형 DataGrid 행 스타일 -->
        <Style x:Key="ModernGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: 상단 필터 바 -->
            <RowDefinition Height="1.2*"/>
            <!-- Row 1: 트렌드 차트 -->
            <RowDefinition Height="1*"/>
            <!-- Row 2: 하단 2열 로그 그리드 -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- Row 0: 상단 검색 및 필터 헤더 카드 -->
        <!-- ========================================================================= -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,10" Padding="16,8" 
                             UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp1"
                             Background="{DynamicResource MaterialDesignPaper}">
            <DockPanel LastChildFill="False">
                <!-- 좌측 타이틀 및 전역 날짜 검색 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ChartLine" Width="22" Height="22" 
                                             Foreground="{DynamicResource MaterialDesignBody}" 
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource Str_DataInquiryTitle}" FontSize="16" FontWeight="Bold" 
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center" Margin="0,0,24,0"/>

                    <TextBlock Text="{DynamicResource Str_InquiryPeriod}" Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7" 
                               VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="12"/>

                    <DatePicker SelectedDate="{Binding GlobalStartDate}" Width="125" Height="30" 
                                VerticalContentAlignment="Center" Padding="4,0"
                                Foreground="{DynamicResource MaterialDesignBody}"/>

                    <TextBlock Text="~" Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.6" 
                               VerticalAlignment="Center" Margin="8,0" FontWeight="Bold"/>

                    <DatePicker SelectedDate="{Binding GlobalEndDate}" Width="125" Height="30" 
                                VerticalContentAlignment="Center" Padding="4,0"
                                Foreground="{DynamicResource MaterialDesignBody}"/>

                    <Button Command="{Binding SearchAllCommand}" Margin="14,0,0,0" 
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="32" Padding="14,0" materialDesign:ButtonAssist.CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str_SearchAll}" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 우측 시계 표시 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18" 
                                             Foreground="{DynamicResource MaterialDesignBody}" 
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding CurrentTimeString}" Foreground="{DynamicResource MaterialDesignBody}" 
                               FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- ========================================================================= -->
        <!-- Row 1: Section 1 - LiveCharts2 라인 그래프 영역 -->
        <!-- ========================================================================= -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,10" Padding="16,14" 
                             UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp1"
                             Background="{DynamicResource MaterialDesignPaper}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 차트 타이틀 바 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Border Width="4" Height="16" Background="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" CornerRadius="2"/>
                        <TextBlock Text="{DynamicResource Str_SectionSummaryChart}" FontWeight="Bold" FontSize="13" 
                                   Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <lvc:CartesianChart Grid.Row="1" 
                                    Background="Transparent"
                                    Series="{Binding TemperatureSeries}"
                                    XAxes="{Binding XAxes}"
                                    YAxes="{Binding YAxes}"
                                    LegendTextPaint="{Binding LegendTextPaint}"
                                    LegendPosition="Right"/>
            </Grid>
        </materialDesign:Card>

        <!-- ========================================================================= -->
        <!-- Row 2: Section 2 & 3 - 하단 2열 이력 데이터그리드 -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- [하단 좌측] 이벤트 및 알람 이력 -->
            <materialDesign:Card Grid.Column="0" Padding="14,12" 
                                 UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp1"
                                 Background="{DynamicResource MaterialDesignPaper}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="4" Height="16" Background="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" CornerRadius="2"/>
                        <TextBlock Text="{DynamicResource Str_SectionEventLogs}" FontWeight="Bold" FontSize="13" 
                                   Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_DateLabel}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" 
                                   Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding EventStartDate}" Width="110" Height="28" FontSize="11" VerticalContentAlignment="Center"/>
                        <TextBlock Text="~" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.6"/>
                        <DatePicker SelectedDate="{Binding EventEndDate}" Width="110" Height="28" FontSize="11" VerticalContentAlignment="Center"/>

                        <Button Command="{Binding SearchEventsCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="28" Padding="10,0" Margin="8,0,0,0" FontSize="11"
                                materialDesign:ButtonAssist.CornerRadius="4">
                            <TextBlock Text="{DynamicResource Str_BtnSearch}"/>
                        </Button>
                        <Button Command="{Binding ExportEventsExcelCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="28" Padding="10,0" Margin="4,0,0,0" FontSize="11"
                                materialDesign:ButtonAssist.CornerRadius="4">
                            <TextBlock Text="{DynamicResource Str_BtnExportExcel}"/>
                        </Button>
                    </WrapPanel>

                    <DataGrid Grid.Row="2" 
                              ItemsSource="{Binding EventLogs}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
                              ColumnHeaderStyle="{StaticResource ModernGridHeader}"
                              RowStyle="{StaticResource ModernGridRow}"
                              CellStyle="{StaticResource ModernGridCell}"
                              Background="Transparent"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource MaterialDesignDivider}"
                              FontSize="11"
                              RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Str_ColOccurTime}" Binding="{Binding DateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="140"/>
                            <DataGridTextColumn Header="{DynamicResource Str_ColLine}" Binding="{Binding Row}" Width="55"/>
                            <DataGridTextColumn Header="{DynamicResource Str_ColBay}" Binding="{Binding Bay}" Width="55"/>
                            <DataGridTextColumn Header="{DynamicResource Str_ColLevel}" Binding="{Binding Level}" Width="55"/>
                            <DataGridTextColumn Header="{DynamicResource Str_ColContent}" Binding="{Binding Content}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- [하단 우측] 이상징후 정밀 덤프 로그 -->
            <materialDesign:Card Grid.Column="2" Padding="14,12" 
                                 UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp1"
                                 Background="{DynamicResource MaterialDesignPaper}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="4" Height="16" Background="#EF4444" Margin="0,0,8,0" CornerRadius="2"/>
                        <TextBlock Text="{DynamicResource Str_SectionDumpLogs}" FontWeight="Bold" FontSize="13" 
                                   Foreground="#EF4444" VerticalAlignment="Center"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,8" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_DateLabel}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" 
                                   Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding DumpStartDate}" Width="110" Height="28" FontSize="11" VerticalContentAlignment="Center"/>
                        <TextBlock Text="~" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.6"/>
                        <DatePicker SelectedDate="{Binding DumpEndDate}" Width="110" Height="28" FontSize="11" VerticalContentAlignment="Center"/>

                        <Button Command="{Binding SearchDumpLogsCommand}" 
                                Background="#EF4444" BorderBrush="#EF4444" Foreground="White" 
                                Height="28" Padding="10,0" Margin="8,0,0,0" FontSize="11"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="4">
                            <TextBlock Text="{DynamicResource Str_BtnSearch}"/>
                        </Button>
                        <Button Command="{Binding ExportDumpExcelCommand}" 
                                Style="{StaticResource MaterialDesignOutlinedButton}" 
                                Height="28" Padding="10,0" Margin="4,0,0,0" FontSize="11"
                                materialDesign:ButtonAssist.CornerRadius="4">
                            <TextBlock Text="{DynamicResource Str_BtnExportExcel}"/>
                        </Button>
                    </WrapPanel>

                    <DataGrid Grid.Row="2" 
                              ItemsSource="{Binding DumpLogs}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
                              ColumnHeaderStyle="{StaticResource ModernGridHeader}"
                              RowStyle="{StaticResource ModernGridRow}"
                              CellStyle="{StaticResource ModernGridCell}"
                              Background="Transparent"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource MaterialDesignDivider}"
                              FontSize="11"
                              RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Str_ColReceiveTime}" Binding="{Binding ReceivedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" Width="150"/>
                            <DataGridTextColumn Header="{DynamicResource Str_ColLine}" Binding="{Binding Row}" Width="50"/>
                            <DataGridTextColumn Header="{DynamicResource Str_ColBay}" Binding="{Binding Bay}" Width="50"/>
                            <DataGridTextColumn Header="{DynamicResource Str_ColLevel}" Binding="{Binding Level}" Width="50"/>
                            <DataGridTextColumn Header="{DynamicResource Str_ColTempWithUnit}" Binding="{Binding Temperature, StringFormat={}{0:N1}}" Width="70"/>
                            <DataGridTextColumn Header="{DynamicResource Str_ColFireStatus}" Binding="{Binding IsFire}" Width="50"/>
                            <DataGridTextColumn Header="{DynamicResource Str_ColErrorStatus}" Binding="{Binding IsError}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>