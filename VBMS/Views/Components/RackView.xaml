<UserControl x:Class="VBMS.Views.Components.RackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Margin="4">
        <!-- ⭐ [유려한 알람 효과] 빨간색 테두리 외곽 글로우 레이어 -->
        <Border x:Name="AlarmGlowBorder"
                CornerRadius="10"
                BorderBrush="{Binding BorderColor}"
                BorderThickness="2"
                Background="Transparent"
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect Color="#F44336" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <!-- ⭐ IsFireAlarm(True) 감지 시 인라인 Storyboard 실행 및 정지 -->
                        <DataTrigger Binding="{Binding IsFireAlarm}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="AlarmPulseBegin">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <!-- TargetName 삭제하여 Style 오류 방지 -->
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.2" To="0.9" Duration="0:0:0.5">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="AlarmPulseBegin"/>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- 메인 카드 본체 -->
        <materialDesign:Card UniformCornerRadius="8"
                             Padding="10,8"
                             materialDesign:ElevationAssist.Elevation="Dp2"
                             BorderBrush="{Binding BorderColor}"
                             BorderThickness="{Binding BorderThickness}"
                             Background="{DynamicResource MaterialDesignPaper}">

            <!-- ⭐ [Step 1 추가] 랙 카드 어디든 더블클릭 시 상세 창 열기 커맨드 실행 -->
            <materialDesign:Card.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenDetailWindowCommand}"/>
            </materialDesign:Card.InputBindings>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 랙 카드 상단 정보 (헤더 영역) -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <!-- 좌측: 랙 명칭 & 온도 칩 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="ServerNetwork" Width="16" Height="16" 
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                 VerticalAlignment="Center" Margin="0,0,4,0"/>

                        <!-- ✏️ 랙 이름: MaterialDesignBody 적용으로 테마 호환성 확보 -->
                        <TextBlock Text="{Binding RackName}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBody}"/>

                        <!-- 온도 표시 뱃지 (Pill 디자인) -->
                        <Border Background="{DynamicResource PrimaryHueLightBrush}" 
                                CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Thermometer" Width="12" Height="12" 
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                         VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBlock Text="{Binding Temperature, StringFormat={}{0:F1} ℃}" 
                                           FontWeight="Bold" FontSize="11" 
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 우측: 상태 뱃지 & 액션 버튼 -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <!-- 상태 뱃지 -->
                        <Border Background="{Binding RackStatusBgColor}" CornerRadius="10" Padding="8,3" Margin="0,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding RackStatusText}" FontWeight="Bold" FontSize="10" Foreground="{Binding RackStatusFgColor}"/>
                        </Border>

                        <!-- 깔끔한 툴바 스타일 아이콘 버튼 (✏️ 아이콘 Foreground에 MaterialDesignBody 추가) -->
                        <Button Style="{StaticResource MaterialDesignToolButton}" Width="24" Height="24" ToolTip="상태 아이콘" Padding="0" Margin="1,0">
                            <materialDesign:PackIcon Kind="Poll" Width="14" Height="14" Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.8"/>
                        </Button>
                        <Button Style="{StaticResource MaterialDesignToolButton}" Width="24" Height="24" ToolTip="온도 상세" Padding="0" Margin="1,0">
                            <materialDesign:PackIcon Kind="Thermometer" Width="14" Height="14" Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.8"/>
                        </Button>

                        <!-- ⭐ [Step 1 추가] 클릭 시 열 상세 정보창 오픈 커맨드 연결 -->
                        <Button Style="{StaticResource MaterialDesignToolButton}" 
                                Command="{Binding OpenDetailWindowCommand}"
                                Width="24" Height="24" ToolTip="그리드 상세" Padding="0" Margin="1,0">
                            <materialDesign:PackIcon Kind="Fullscreen" Width="14" Height="14" Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.8"/>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- 배터리 셀 바둑판 그리드 영역 -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource MaterialDesignBackground}" 
                        BorderBrush="{DynamicResource MaterialDesignDivider}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="4" 
                        MinHeight="220">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 연(Bay) 헤더 (✏️ MaterialDesignBody + Opacity로 가독성 개선) -->
                        <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding BayLabels}" Margin="0,0,0,2">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding GridColumns}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="8" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" 
                                               Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 단(Level) 헤더 (✏️ MaterialDesignBody + Opacity로 가독성 개선) -->
                        <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding LevelLabels}" Margin="0,0,2,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding GridRows}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="8" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Margin="0,0,3,0"
                                               Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.7"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 셀 그리드 -->
                        <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CellList}">
                            <ItemsControl.RenderTransform>
                                <ScaleTransform ScaleY="-1"/>
                            </ItemsControl.RenderTransform>
                            <ItemsControl.RenderTransformOrigin>0.5,0.5</ItemsControl.RenderTransformOrigin>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding GridColumns}" Rows="{Binding GridRows}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CellColor}" 
                                            Margin="0.5" 
                                            CornerRadius="1" 
                                            ToolTip="{Binding CellTooltip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <!-- 마우스 호버 시 강조 효과 -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>