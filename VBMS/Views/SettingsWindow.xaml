<Window x:Class="VBMS.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Str_SettingsTitle}"
        Height="540" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignBackground}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: 상단 헤더 -->
            <RowDefinition Height="*"/>
            <!-- Row 1: 4대 카테고리 탭 영역 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: 하단 액션 버튼 -->
        </Grid.RowDefinitions>

        <!-- 상단 헤더 -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,12" Padding="14,10"
                             UniformCornerRadius="6" materialDesign:ElevationAssist.Elevation="Dp1"
                             Background="{DynamicResource MaterialDesignPaper}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Cog" Width="24" Height="24" 
                                         Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource Str_SettingsTitle}" FontSize="16" FontWeight="Bold" 
                           VerticalAlignment="Center"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- 4대 카테고리 탭 본문 -->
        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}">

            <!-- Tab 1: 일반 (General) -->
            <TabItem Header="{DynamicResource Str_TabGeneral}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <materialDesign:Card Padding="16" UniformCornerRadius="6" Background="{DynamicResource MaterialDesignPaper}">
                        <StackPanel>
                            <!-- 시스템 표시 언어 -->
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_SettingLanguage}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding LanguageList}"
                                          SelectedValuePath="Code"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValue="{Binding SelectedLanguage}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                            </Grid>

                            <!-- 기본 테마 -->
                            <Grid Margin="0,16,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_SettingTheme}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ThemeList}"
                                          SelectedValuePath="Code"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValue="{Binding SelectedTheme}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 안전/임계치 (Safety) -->
            <TabItem Header="{DynamicResource Str_TabSafety}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <materialDesign:Card Padding="16" UniformCornerRadius="6" Background="{DynamicResource MaterialDesignPaper}">
                        <StackPanel>
                            <!-- 고온 화재 임계치 -->
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" Background="#F44336" CornerRadius="4" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource Str_SettingHighTemp}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding HighTempThreshold, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="℃" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.7"/>
                            </Grid>

                            <!-- 주의 경보 임계치 -->
                            <Grid Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" Background="#FF9800" CornerRadius="4" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource Str_SettingWarningTemp}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding WarningTempThreshold, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="℃" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.7"/>
                            </Grid>

                            <!-- 평균 대비 편차 임계치 -->
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" Background="#FFC107" CornerRadius="4" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource Str_SettingDeltaTemp}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBox Grid.Column="1" Text="{Binding DeltaTempThreshold, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="℃" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.7"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: 네트워크 (Network) -->
            <TabItem Header="{DynamicResource Str_TabNetwork}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <materialDesign:Card Padding="16" UniformCornerRadius="6" Background="{DynamicResource MaterialDesignPaper}">
                        <StackPanel>
                            <!-- TCP 수신 포트 -->
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_SettingServerPort}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox Grid.Column="1" Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.7"/>
                            </Grid>

                            <!-- 통신 두절 판정 시간 -->
                            <Grid Margin="0,16,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_SettingTimeout}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox Grid.Column="1" Text="{Binding BoardTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="초 (s)" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.7"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: 저장소 (Storage) -->
            <TabItem Header="{DynamicResource Str_TabStorage}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <materialDesign:Card Padding="16" UniformCornerRadius="6" Background="{DynamicResource MaterialDesignPaper}">
                        <StackPanel>
                            <!-- 엑셀 및 데이터 내보내기 경로 -->
                            <TextBlock Text="{DynamicResource Str_SettingExportDir}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ExportDirectory, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{Binding BrowseExportDirectoryCommand}" 
                                        Content="{DynamicResource Str_BtnBrowse}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Height="30" Margin="8,0,0,0" Padding="12,0"/>
                            </Grid>

                            <!-- 실시간 이벤트 로그 최대 보관 개수 -->
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Str_SettingLogCapacity}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox Grid.Column="1" Text="{Binding MaxEventLogCount, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="개" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.7"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 하단 액션 버튼 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource MaterialDesignFlatButton}" 
                    Content="{DynamicResource Str_BtnCancel}" 
                    Command="{Binding CancelCommand}" 
                    Width="85" Margin="0,0,8,0"/>
            <Button Style="{StaticResource MaterialDesignRaisedButton}" 
                    Content="{DynamicResource Str_BtnSave}" 
                    Command="{Binding SaveCommand}" 
                    Width="95"/>
        </StackPanel>
    </Grid>
</Window>