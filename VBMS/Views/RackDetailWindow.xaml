<Window x:Class="VBMS.Views.RackDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding WindowTitle}" 
        Height="840" Width="1600"
        MinHeight="720" MinWidth="1150"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignBackground}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        FontFamily="{materialDesign:MaterialDesignFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- 상태 고정 컬러 브러시 -->
        <SolidColorBrush x:Key="ColorNormal" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ColorCommError" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="ColorSmoke" Color="#FF9800"/>
        <SolidColorBrush x:Key="ColorFire" Color="#F44336"/>
        <SolidColorBrush x:Key="ColorDisabled" Color="#607D8B"/>

        <!-- 빠른 구역 이동 탭 버튼 스타일 -->
        <Style x:Key="SegmentTabButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesignBackground}"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: 상단 헤더 영역 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: 16단위 빠른 구역 이동 탭 -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: 메인 셀 그리드 -->
            <RowDefinition Height="*"/>
            <!-- Row 3: 하단 현황 대시보드 -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- Row 0: 상단 헤더 카드 -->
        <!-- ========================================================================= -->
        <materialDesign:Card Grid.Row="0" Margin="0,0,0,10" Padding="16,10" 
                             UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp1"
                             Background="{DynamicResource MaterialDesignPaper}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ServerNetwork" Width="22" Height="22" 
                                             Foreground="{DynamicResource MaterialDesignBody}" 
                                             VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <TextBlock Text="{Binding Rack.RackName}" FontSize="17" FontWeight="Bold" 
                               Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>

                    <!-- 센서 평균 온도 뱃지 -->
                    <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="12" 
                            Height="26" Padding="10,0" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Thermometer" Width="14" Height="14" 
                                                     Foreground="{DynamicResource MaterialDesignBody}" 
                                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Rack.AverageCellTemperature, StringFormat={}{0:F1} ℃}" 
                                       FontWeight="Bold" FontSize="11" 
                                       Foreground="{DynamicResource MaterialDesignBody}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 설비 상태 뱃지 -->
                    <Border Background="{Binding Rack.RackStatusBgColor}" CornerRadius="12" 
                            Height="26" Padding="10,0" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Rack.RackStatusText, FallbackValue='대기'}" FontWeight="Bold" FontSize="11" 
                                   Foreground="{Binding Rack.RackStatusFgColor}" 
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- ========================================================================= -->
        <!-- Row 1: 16단위 빠른 구역 이동 세그먼트 바 (다국어 라벨 적용) -->
        <!-- ========================================================================= -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,10" Padding="10,6" 
                             UniformCornerRadius="6" materialDesign:ElevationAssist.Elevation="Dp1"
                             Background="{DynamicResource MaterialDesignPaper}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str_SnapJump}" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" 
                               Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.6" Margin="6,0,12,0"/>
                    <Button Style="{StaticResource SegmentTabButtonStyle}" Tag="1" Click="JumpBay_Click">
                        <TextBlock><Run Text="01 ~ 16 "/><Run Text="{DynamicResource Str_UnitBay}"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource SegmentTabButtonStyle}" Tag="17" Click="JumpBay_Click">
                        <TextBlock><Run Text="17 ~ 32 "/><Run Text="{DynamicResource Str_UnitBay}"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource SegmentTabButtonStyle}" Tag="33" Click="JumpBay_Click">
                        <TextBlock><Run Text="33 ~ 48 "/><Run Text="{DynamicResource Str_UnitBay}"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource SegmentTabButtonStyle}" Tag="49" Click="JumpBay_Click">
                        <TextBlock><Run Text="49 ~ 64 "/><Run Text="{DynamicResource Str_UnitBay}"/></TextBlock>
                    </Button>
                    <Button Style="{StaticResource SegmentTabButtonStyle}" Tag="65" Click="JumpBay_Click">
                        <TextBlock><Run Text="65 ~ 70 "/><Run Text="{DynamicResource Str_UnitBay}"/></TextBlock>
                    </Button>
                </StackPanel>
            </DockPanel>
        </materialDesign:Card>

        <!-- ========================================================================= -->
        <!-- Row 2: 메인 셀 그리드 -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2" 
                Background="{DynamicResource MaterialDesignPaper}" 
                BorderBrush="{DynamicResource MaterialDesignDivider}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="12,10" 
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 좌측 단(Level) 헤더 -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Rack.LevelLabels}" 
                              Margin="0,32,6,0" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="34">
                                <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold" 
                                           VerticalAlignment="Center" HorizontalAlignment="Right" 
                                           Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.75"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 가로 스크롤 뷰포트 -->
                <ScrollViewer Grid.Column="1" 
                              x:Name="MainCellScrollViewer"
                              HorizontalScrollBarVisibility="Auto" 
                              VerticalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel Orientation="Vertical">
                        <!-- 1. 상단 연(Bay) 헤더 -->
                        <ItemsControl ItemsSource="{Binding SimplifiedBayLabels}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="52" Height="26" Margin="1,0" 
                                            Background="{DynamicResource MaterialDesignBackground}" 
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="1" 
                                            CornerRadius="3">
                                        <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                   Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.8"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 2. 메인 배터리 셀 그리드 (ListBox) -->
                        <ListBox x:Name="CellListBox" 
                                 ItemsSource="{Binding Rack.CellList}"
                                 SelectedItem="{Binding SelectedCell, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 Focusable="True"
                                 PreviewKeyDown="CellListBox_PreviewKeyDown"
                                 PreviewMouseRightButtonDown="CellListBox_PreviewMouseRightButtonDown"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">

                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Str_ResetDetector}" 
                                              Command="{Binding ResetSelectedCellSensorCommand}"
                                              CommandParameter="{Binding SelectedCell}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="Refresh" Foreground="{DynamicResource MaterialDesignBody}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>

                            <!-- 그리드 뒤집기 -->
                            <ListBox.RenderTransform>
                                <ScaleTransform ScaleY="-1"/>
                            </ListBox.RenderTransform>
                            <ListBox.RenderTransformOrigin>0.5,0.5</ListBox.RenderTransformOrigin>

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Rack.GridColumns}" Rows="{Binding Rack.GridRows}"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{x:Null}">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="1"/>
                                    <Setter Property="Width" Value="52"/>
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="SelectionBorder" 
                                                        BorderBrush="Transparent" 
                                                        BorderThickness="1.5" 
                                                        CornerRadius="3" 
                                                        Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                        <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="2"/>
                                                        <Setter Property="Panel.ZIndex" Value="10"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#FFD600"/>
                                                        <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="1.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CellColor}" 
                                            CornerRadius="3" 
                                            ToolTip="{Binding CellTooltip}" 
                                            Cursor="Hand">
                                        <TextBlock Text="{Binding Temperature, StringFormat={}{0:F1}℃, FallbackValue=''}" 
                                                   FontSize="10" 
                                                   FontWeight="Bold" 
                                                   Foreground="White" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <ScaleTransform ScaleY="-1"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- Row 3: 하단 현황 대시보드 -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.8*"/>
                <ColumnDefinition Width="3.2*"/>
                <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <!-- 카드 1: 셀 상태 요약 -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Padding="12" Margin="0,0,8,0" 
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 Background="{DynamicResource MaterialDesignPaper}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ChartPie" Width="16" Height="16" 
                                                     Foreground="{DynamicResource MaterialDesignBody}" 
                                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Str_CellSummary}" FontWeight="Bold" FontSize="12" 
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- 전체 개수 뱃지 (다국어 포맷 바인딩) -->
                        <Border DockPanel.Dock="Right" Background="{DynamicResource MaterialDesignDivider}" CornerRadius="10" Padding="8,2">
                            <TextBlock Text="{Binding TotalCountText}" FontSize="10" FontWeight="Bold" 
                                       Foreground="{DynamicResource MaterialDesignBody}" Opacity="0.8"/>
                        </Border>
                    </DockPanel>

                    <Separator Grid.Row="1" Margin="0,0,0,8"/>

                    <UniformGrid Grid.Row="2" Columns="5" VerticalAlignment="Center">
                        <!-- 정상 -->
                        <Border Margin="2" Background="{DynamicResource MaterialDesignBackground}" CornerRadius="4" Padding="4,6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_StatusNormal}" FontSize="10" Foreground="{StaticResource ColorNormal}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NormalCount}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource ColorNormal}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- 통신오류 -->
                        <Border Margin="2" Background="{DynamicResource MaterialDesignBackground}" CornerRadius="4" Padding="4,6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_StatusCommError}" FontSize="10" Foreground="{StaticResource ColorCommError}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CommErrorCount}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource ColorCommError}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- 연기 -->
                        <Border Margin="2" Background="{DynamicResource MaterialDesignBackground}" CornerRadius="4" Padding="4,6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_StatusSmoke}" FontSize="10" Foreground="{StaticResource ColorSmoke}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SmokeCount}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource ColorSmoke}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- 화재 -->
                        <Border Margin="2" Background="{DynamicResource MaterialDesignBackground}" CornerRadius="4" Padding="4,6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_StatusFire}" FontSize="10" Foreground="{StaticResource ColorFire}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding FireCount}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource ColorFire}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- 중지 -->
                        <Border Margin="2" Background="{DynamicResource MaterialDesignBackground}" CornerRadius="4" Padding="4,6">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_StatusDisabled}" FontSize="10" Foreground="{StaticResource ColorDisabled}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding DisabledCount}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource ColorDisabled}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </materialDesign:Card>

            <!-- 카드 2: 선택된 셀 정보 & 리셋 버튼 -->
            <materialDesign:Card Grid.Column="1" UniformCornerRadius="8" Padding="12" Margin="0,0,8,0" 
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 Background="{DynamicResource MaterialDesignPaper}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" 
                                                     Foreground="{DynamicResource MaterialDesignBody}" 
                                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Str_SelectedNodeDiag}" FontWeight="Bold" FontSize="12" 
                                       Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 위치 뱃지 (연/단 단위 다국어 Run 적용) -->
                        <Border DockPanel.Dock="Right" Background="{DynamicResource MaterialDesignDivider}" CornerRadius="10" Padding="8,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" FontSize="11" VerticalAlignment="Center">
                                    <Run Text="{Binding SelectedCell.Bay, FallbackValue='--'}"/>
                                    <Run Text="{DynamicResource Str_UnitBay}"/>
                                    <Run Text=" "/>
                                </TextBlock>
                                <TextBlock FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" FontSize="11" VerticalAlignment="Center">
                                    <Run Text="{Binding SelectedCell.Level, StringFormat='{}{0:00}', FallbackValue='--'}"/>
                                    <Run Text="{DynamicResource Str_UnitLevel}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Separator Grid.Row="1" Margin="0,0,0,8"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <!-- 텔레메트리 텍스트 -->
                        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignBackground}" 
                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" 
                                CornerRadius="4" Padding="8" Margin="0,0,8,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding SelectedCell.CellTooltip, FallbackValue='셀을 선택하면 상세 정보가 표시됩니다.'}" 
                                           FontSize="11" FontFamily="Consolas, Malgun Gothic" LineHeight="16" 
                                           Foreground="{DynamicResource MaterialDesignBody}" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <!-- 리셋 버튼 (다국어 리소스 적용) -->
                        <Button Grid.Column="1" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Command="{Binding ResetSelectedCellSensorCommand}"
                                CommandParameter="{Binding SelectedCell}"
                                IsEnabled="{Binding HasSelectedCell}"
                                Height="Auto"
                                Padding="8,0"
                                VerticalAlignment="Stretch"
                                materialDesign:ButtonAssist.CornerRadius="4"
                                ToolTip="{DynamicResource Str_ResetDetectorTooltip}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="{DynamicResource Str_ResetDetector}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- 카드 3: 상태 범례 -->
            <materialDesign:Card Grid.Column="2" UniformCornerRadius="8" Padding="12" 
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 Background="{DynamicResource MaterialDesignPaper}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                        <materialDesign:PackIcon Kind="PaletteOutline" Width="16" Height="16" 
                                                 Foreground="{DynamicResource MaterialDesignBody}" 
                                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_StatusLegend}" FontWeight="Bold" FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBody}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Separator Grid.Row="1" Margin="0,0,0,8"/>

                    <UniformGrid Grid.Row="2" Columns="2" Rows="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,4">
                            <Border Width="10" Height="10" Background="{StaticResource ColorNormal}" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str_StatusNormal}" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,4">
                            <Border Width="10" Height="10" Background="{StaticResource ColorCommError}" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str_StatusCommError}" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,4">
                            <Border Width="10" Height="10" Background="{StaticResource ColorSmoke}" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str_StatusSmoke}" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,4">
                            <Border Width="10" Height="10" Background="{StaticResource ColorFire}" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str_StatusFire}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ColorFire}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,4">
                            <Border Width="10" Height="10" Background="{StaticResource ColorDisabled}" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str_StatusDisabled}" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>