<Window x:Class="VBMS.Views.RackDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Rack.RackName, StringFormat='{}랙 상세 정보 - {0}'}" 
        Height="1000" Width="1600"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: 상단 헤더 -->
            <RowDefinition Height="*"/>
            <!-- 1: 메인 셀 그리드 -->
            <RowDefinition Height="Auto"/>
            <!-- 2: 하단 현황 대시보드 -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- Row 0: 상단 헤더 영역 -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,8" Background="{DynamicResource MaterialDesignBackground}" CornerRadius="6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ServerNetwork" Width="28" Height="28" 
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Rack.RackName}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>

                    <!-- 온도 표시 -->
                    <Border Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="12" Padding="12,4" Margin="16,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Thermometer" Width="16" Height="16" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Rack.Temperature, StringFormat={}{0:F1} ℃}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 상태 뱃지 -->
                    <Border Background="{Binding Rack.RackStatusBgColor}" CornerRadius="12" Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Rack.RackStatusText}" FontWeight="Bold" FontSize="12" Foreground="{Binding Rack.RackStatusFgColor}"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- Row 1: 메인 셀 그리드 -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" 
                Background="{DynamicResource MaterialDesignBackground}" 
                BorderBrush="{DynamicResource MaterialDesignDivider}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="10" 
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. 상단 연(Bay) 헤더 -->
                <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SimplifiedBayLabels}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Rack.GridColumns}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 2. 좌측 단(Level) 헤더 -->
                <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Rack.LevelLabels}" Margin="0,0,4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding Rack.GridRows}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 3. 메인 배터리 셀 그리드 (ListBox) -->
                <ListBox Grid.Row="1" Grid.Column="1" 
                         x:Name="CellListBox"
                         ItemsSource="{Binding Rack.CellList}"
                         SelectedItem="{Binding SelectedCell, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Focusable="True"
                         PreviewKeyDown="CellListBox_PreviewKeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.RenderTransform>
                        <ScaleTransform ScaleY="-1"/>
                    </ListBox.RenderTransform>
                    <ListBox.RenderTransformOrigin>0.5,0.5</ListBox.RenderTransformOrigin>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Rack.GridColumns}" Rows="{Binding Rack.GridRows}"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Focusable" Value="True"/>

                            <!-- 셀 우클릭 감지기 리셋 컨텍스트 메뉴 -->
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="감지기 리셋" 
                                                  Command="{Binding DataContext.ResetSelectedCellSensorCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Refresh"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="SelectionBorder" 
                                                BorderBrush="Transparent" 
                                                BorderThickness="1.5" 
                                                CornerRadius="1" 
                                                Margin="0.2"
                                                Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- 선택 시 시안색 테두리 -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="2"/>
                                                <Setter Property="Panel.ZIndex" Value="10"/>
                                            </Trigger>
                                            <!-- 마우스 호버 시 노란색 테두리 -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#FFD600"/>
                                                <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="1.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding CellColor}" 
                                    CornerRadius="0.5" 
                                    ToolTip="{Binding CellTooltip}" 
                                    Cursor="Hand"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- Row 2: 하단 현황 대시보드 (개선된 리셋 버튼 및 반응형 레이아웃) -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="2.8*"/>
                <ColumnDefinition Width="2.0*"/>
            </Grid.ColumnDefinitions>

            <!-- 카드 1: 셀 상태 요약 -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="8" Padding="14" Margin="0,0,8,0" materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="ChartPie" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="셀 상태 요약" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Separator Margin="0,0,0,10"/>
                    <UniformGrid Columns="6">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="전체" FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="정상" FontSize="11" Foreground="#4CAF50" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding NormalCount}" FontWeight="Bold" FontSize="16" Foreground="#4CAF50" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="통신오류" FontSize="11" Foreground="#9E9E9E" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CommErrorCount}" FontWeight="Bold" FontSize="16" Foreground="#9E9E9E" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="연기감지" FontSize="11" Foreground="#FF9800" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SmokeCount}" FontWeight="Bold" FontSize="16" Foreground="#FF9800" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="화재발생" FontSize="11" Foreground="#F44336" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding FireCount}" FontWeight="Bold" FontSize="16" Foreground="#F44336" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="사용중지" FontSize="11" Foreground="#607D8B" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding DisabledCount}" FontWeight="Bold" FontSize="16" Foreground="#607D8B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </materialDesign:Card>

            <!-- 카드 2: 선택된 셀 정보 & 대형 리셋 버튼 -->
            <materialDesign:Card Grid.Column="1" UniformCornerRadius="8" Padding="14" Margin="0,0,8,0" materialDesign:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 카드 헤더 & 위치 정보 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="선택된 셀 정보" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 위치 뱃지 -->
                        <Border DockPanel.Dock="Right" Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="12" Padding="10,2" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MapMarkerOutline" Width="14" Height="14" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                <TextBlock Text="{Binding SelectedCell.Bay, StringFormat='{} {0}연 '}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedCell.Level, StringFormat='{}{0:00}단'}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Separator Grid.Row="1" Margin="0,0,0,8"/>

                    <!-- 상세 내용 및 리셋 버튼 컨텐츠 영역 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 툴팁 정보 텍스트 박스 -->
                        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignBackground}" CornerRadius="6" Padding="10" Margin="0,0,10,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding SelectedCell.CellTooltip}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Foreground="{DynamicResource MaterialDesignBody}"/>
                            </ScrollViewer>
                        </Border>

                        <!-- ⭐ 가시성이 향상된 리셋 버튼 -->
                        <Button Grid.Column="1" 
                                Style="{StaticResource MaterialDesignRaisedButton}" 
                                Command="{Binding ResetSelectedCellSensorCommand}"
                                CommandParameter="{Binding SelectedCell}"
                                IsEnabled="{Binding HasSelectedCell}"
                                Height="42" 
                                Padding="16,0"
                                VerticalAlignment="Center"
                                ToolTip="선택한 셀의 감지기 오류 상태를 초기화합니다.">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="감지기 리셋" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- 카드 3: 상태 범례 -->
            <materialDesign:Card Grid.Column="2" UniformCornerRadius="8" Padding="14" materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="PaletteOutline" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="상태 범례" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Separator Margin="0,0,0,10"/>

                    <UniformGrid Columns="2" Rows="3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4">
                            <Border Width="12" Height="12" Background="#4CAF50" CornerRadius="3" Margin="0,0,8,0"/>
                            <TextBlock Text="정상" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4">
                            <Border Width="12" Height="12" Background="#9E9E9E" CornerRadius="3" Margin="0,0,8,0"/>
                            <TextBlock Text="통신오류" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4">
                            <Border Width="12" Height="12" Background="#FF9800" CornerRadius="3" Margin="0,0,8,0"/>
                            <TextBlock Text="연기감지" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4">
                            <Border Width="12" Height="12" Background="#F44336" CornerRadius="3" Margin="0,0,8,0"/>
                            <TextBlock Text="화재발생" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,4">
                            <Border Width="12" Height="12" Background="#607D8B" CornerRadius="3" Margin="0,0,8,0"/>
                            <TextBlock Text="사용중지" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>