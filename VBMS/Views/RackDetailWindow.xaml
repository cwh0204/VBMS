<Window x:Class="VBMS.Views.RackDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Rack.RackName, StringFormat='{}랙 상세 정보 - {0}'}" 
        Height="800" Width="1350"
        MinHeight="650" MinWidth="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: 상단 헤더 -->
            <RowDefinition Height="*"/>
            <!-- 1: 메인 셀 그리드 -->
            <RowDefinition Height="Auto"/>
            <!-- 2: 하단 현황 대시보드 -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- Row 0: 상단 헤더 영역 -->
        <!-- ========================================================================= -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="ServerNetwork" Width="26" Height="26" 
                                         Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Rack.RackName}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                <!-- 온도 표시 -->
                <Border Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Thermometer" Width="14" Height="14" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding Rack.Temperature, StringFormat={}{0:F1} ℃}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 상태 뱃지 -->
                <Border Background="{Binding Rack.RackStatusBgColor}" CornerRadius="12" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Rack.RackStatusText}" FontWeight="Bold" FontSize="11" Foreground="{Binding Rack.RackStatusFgColor}"/>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- ========================================================================= -->
        <!-- Row 1: 메인 셀 그리드 -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" 
                Background="{DynamicResource MaterialDesignBackground}" 
                BorderBrush="{DynamicResource MaterialDesignDivider}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="10" 
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. 상단 연(Bay) 헤더 -->
                <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SimplifiedBayLabels}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Rack.GridColumns}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 2. 좌측 단(Level) 헤더 -->
                <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Rack.LevelLabels}" Margin="0,0,4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding Rack.GridRows}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 3. 메인 배터리 셀 그리드 (ListBox) -->
                <ListBox Grid.Row="1" Grid.Column="1" 
                         x:Name="CellListBox"
                         ItemsSource="{Binding Rack.CellList}"
                         SelectedItem="{Binding SelectedCell, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         Focusable="True"
                         PreviewKeyDown="CellListBox_PreviewKeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.RenderTransform>
                        <ScaleTransform ScaleY="-1"/>
                    </ListBox.RenderTransform>
                    <ListBox.RenderTransformOrigin>0.5,0.5</ListBox.RenderTransformOrigin>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Rack.GridColumns}" Rows="{Binding Rack.GridRows}"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Focusable" Value="True"/>

                            <!-- 셀 우클릭 감지기 리셋 컨텍스트 메뉴 -->
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="감지기 리셋" 
                                                  Command="{Binding DataContext.ResetSelectedCellSensorCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Refresh"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- Margin="0.2"로 축소하여 셀 간격 밀착 -->
                                        <Border x:Name="SelectionBorder" 
                                                BorderBrush="Transparent" 
                                                BorderThickness="1.5" 
                                                CornerRadius="1" 
                                                Margin="0.2"
                                                Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- 선택 시 시안색 테두리 -->
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="2"/>
                                                <Setter Property="Panel.ZIndex" Value="10"/>
                                            </Trigger>
                                            <!-- 마우스 호버 시 노란색 테두리 -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#FFD600"/>
                                                <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="1.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding CellColor}" 
                                    CornerRadius="0.5" 
                                    ToolTip="{Binding CellTooltip}" 
                                    Cursor="Hand"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- Row 2: 하단 현황 대시보드 (5대 실무 상태값 적용) -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- 카드 1: 셀 상태 요약 -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="6" Padding="12" Margin="0,0,8,0" materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="셀 상태 요약" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                    <Separator Margin="0,0,0,8"/>
                    <UniformGrid Columns="6">
                        <StackPanel>
                            <TextBlock Text="전체" FontSize="11" Foreground="Gray"/>
                            <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="정상" FontSize="11" Foreground="#4CAF50"/>
                            <TextBlock Text="{Binding NormalCount}" FontWeight="Bold" FontSize="15" Foreground="#4CAF50"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="통신오류" FontSize="10" Foreground="#9E9E9E"/>
                            <TextBlock Text="{Binding CommErrorCount}" FontWeight="Bold" FontSize="15" Foreground="#9E9E9E"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="연기감지" FontSize="10" Foreground="#FF9800"/>
                            <TextBlock Text="{Binding SmokeCount}" FontWeight="Bold" FontSize="15" Foreground="#FF9800"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="화재발생" FontSize="10" Foreground="#F44336"/>
                            <TextBlock Text="{Binding FireCount}" FontWeight="Bold" FontSize="15" Foreground="#F44336"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="사용중지" FontSize="10" Foreground="#607D8B"/>
                            <TextBlock Text="{Binding DisabledCount}" FontWeight="Bold" FontSize="15" Foreground="#607D8B"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </materialDesign:Card>

            <!-- 카드 2: 선택된 셀 정보 & 리셋 버튼 -->
            <materialDesign:Card Grid.Column="1" UniformCornerRadius="6" Padding="12" Margin="0,0,8,0" materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="선택된 셀 정보" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding SelectedCell.Bay, StringFormat='{} [ {0}연 '}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedCell.Level, StringFormat='{}{0:00}단 ]'}" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>

                            <!-- 선택 셀 감지기 리셋 버튼 -->
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Content="리셋" 
                                    Padding="8,0" 
                                    Height="24" 
                                    FontSize="11"
                                    Command="{Binding ResetSelectedCellSensorCommand}"
                                    CommandParameter="{Binding SelectedCell}"
                                    IsEnabled="{Binding HasSelectedCell}"/>
                        </StackPanel>
                    </DockPanel>
                    <Separator Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding SelectedCell.CellTooltip}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- 카드 3: 상태 범례 -->
            <materialDesign:Card Grid.Column="2" UniformCornerRadius="6" Padding="12" materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="상태 범례" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                    <Separator Margin="0,0,0,8"/>
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                            <Border Width="12" Height="12" Background="#4CAF50" CornerRadius="2" Margin="0,0,5,0"/>
                            <TextBlock Text="정상" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                            <Border Width="12" Height="12" Background="#9E9E9E" CornerRadius="2" Margin="0,0,5,0"/>
                            <TextBlock Text="통신오류" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                            <Border Width="12" Height="12" Background="#FF9800" CornerRadius="2" Margin="0,0,5,0"/>
                            <TextBlock Text="연기감지" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,12,2">
                            <Border Width="12" Height="12" Background="#F44336" CornerRadius="2" Margin="0,0,5,0"/>
                            <TextBlock Text="화재발생" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                            <Border Width="12" Height="12" Background="#607D8B" CornerRadius="2" Margin="0,0,5,0"/>
                            <TextBlock Text="사용중지" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>